---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: posts } = await supabase
  .from('posts')
  .select('title, slug, created_at')
  .order('created_at', { ascending: false });
---

<Layout title="All Guitar Learning Guides | Urban Acoustics Mumbai">
  <main style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem;">
    <h1 style="font-size: 2.25rem; font-weight: 700; margin-bottom: 1rem;">
      All Mumbai Location Guides
    </h1>
    <p style="color: #4b5563; margin-bottom: 2rem;">
      Browse our complete directory of localized guitar coaching and academy guides across Mumbai localities.
    </p>

    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
      {posts && posts.map((post) => (
        <li style="padding: 1.25rem; background: #ffffff; border-radius: 8px; border: 1px solid #e5e7eb;">
          <a 
            href={`/posts/${post.slug}`} 
            style="font-size: 1.125rem; font-weight: 600; color: #2563eb; text-decoration: none;"
          >
            {post.title}
          </a>
          <p style="font-size: 0.875rem; color: #6b7280; margin-top: 0.25rem;">
            Published on {new Date(post.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </p>
        </li>
      ))}
    </ul>
  </main>
</Layout>