---
export const prerender = false;
Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');

const SITE_URL = 'https://urban-acoustics-mumbai.vercel.app';
const canonicalURL = SITE_URL + '/guides';
---

<!DOCTYPE html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Guide Archive Under Review | Urban Acoustics Mumbai</title>
  <meta name="description" content="The Urban Acoustics Mumbai guide archive is undergoing editorial review." />
  <meta name="robots" content="noindex,follow" />
  <link rel="canonical" href={canonicalURL} />
  <style>
    body{font-family:system-ui,sans-serif;background:#f9fafb;color:#111827;margin:0;padding:4rem 1rem}
    main{max-width:720px;margin:auto;background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:2rem}
    h1{font-size:2.2rem;margin-top:0}p{line-height:1.7;color:#4b5563}a{color:#1d4ed8}
  </style>
</head>
<body>
  <main>
    <a href="/">← Urban Acoustics Mumbai</a>
    <h1>Guide archive under editorial review</h1>
    <p>Older automatically generated locality guides are being checked for factual accuracy, duplication and usefulness. They are temporarily excluded from search indexing and from this public archive.</p>
    <p>For current private guitar lesson information, visit the <a href="https://guitar-classes-in-mumbai.vercel.app/" rel="sponsored noopener">official Guitar Classes in Mumbai website</a>.</p>
  </main>
</body>
</html>