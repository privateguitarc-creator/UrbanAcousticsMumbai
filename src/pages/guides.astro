---
// Force SSR so new database posts appear instantly on every refresh
export const prerender = false;

import { supabase } from '../lib/supabase';

// Fetch posts strictly sorted by published_at DESCENDING (newest first)
const { data: posts, error } = await supabase
  .from('posts')
  .select('title, slug, published_at')
  .order('published_at', { ascending: false });

if (error) {
  console.error('Error fetching posts:', error);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Mumbai Guitar Class Guides | Urban Acoustics</title>
    <meta name="description" content="Complete directory of localized guitar coaching, academies, and tutor guides across Mumbai." />
    <style>
      :root {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        color-scheme: light;
      }
      body {
        margin: 0;
        background-color: #f9fafb;
        color: #111827;
        min-height: 100vh;
        padding: 3rem 1rem;
      }
      .container {
        max-width: 800px;
        margin: 0 auto;
      }
      .nav-link {
        color: #2563eb;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 600;
      }
      .nav-link:hover {
        text-decoration: underline;
      }
      h1 {
        font-size: 2.25rem;
        font-weight: 800;
        margin-top: 0.5rem;
        margin-bottom: 0.25rem;
        letter-spacing: -0.025em;
      }
      .subtitle {
        color: #4b5563;
        font-size: 0.95rem;
        margin-bottom: 2rem;
      }
      .guides-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .guide-card {
        display: block;
        padding: 1.25rem 1.5rem;
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        text-decoration: none;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        transition: all 0.15s ease-in-out;
      }
      .guide-card:hover {
        border-color: #2563eb;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        transform: translateY(-1px);
      }
      .guide-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: #2563eb;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="nav-link">← Home</a>
        <h1>All Mumbai Location Guides</h1>
        <p class="subtitle">Browse our full directory of localized guitar coaching and academy guides across Mumbai.</p>
      </header>

      <main>
        {(!posts || posts.length === 0) ? (
          <p>No posts published yet.</p>
        ) : (
          <div class="guides-list">
            {posts.map((post) => (
              <a href={`/posts/${post.slug}`} class="guide-card">
                <h2 class="guide-title">{post.title}</h2>
              </a>
            ))}
          </div>
        )}
      </main>
    </div>
  </body>
</html>