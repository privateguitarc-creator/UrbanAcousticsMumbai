---
export const prerender = false;

import { supabase } from '../lib/supabase';

const SITE_URL = 'https://urban-acoustics-mumbai.vercel.app';
const canonicalURL = SITE_URL + '/guides';

const { data: posts, error } = await supabase
  .from('posts')
  .select('title, slug, published_at')
  .order('published_at', { ascending: false });

if (error) console.error('Error fetching posts:', error);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mumbai Guitar Learning Guides | Urban Acoustics</title>
    <meta name="description" content="Browse Urban Acoustics Mumbai guides about guitar lessons, practice, lesson formats and local learning considerations across Mumbai." />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content="Mumbai Guitar Learning Guides | Urban Acoustics" />
    <meta property="og:description" content="Browse practical guitar-learning guides for Mumbai." />
    <meta property="og:url" content={canonicalURL} />
    <style>
      :root { font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
      body { margin:0; background:#f9fafb; color:#111827; min-height:100vh; padding:3rem 1rem; }
      .container { max-width:820px; margin:0 auto; }
      .nav-link { color:#2563eb; text-decoration:none; font-size:.9rem; font-weight:600; }
      h1 { font-size:2.25rem; margin:.8rem 0 .4rem; letter-spacing:-.025em; }
      .subtitle { color:#4b5563; line-height:1.6; margin-bottom:2rem; }
      .guides-list { display:flex; flex-direction:column; gap:.75rem; }
      .guide-card { display:block; padding:1.2rem 1.4rem; background:#fff; border-radius:10px; border:1px solid #e5e7eb; text-decoration:none; }
      .guide-card:hover { border-color:#2563eb; }
      .guide-title { font-size:1.05rem; font-weight:650; color:#1d4ed8; margin:0 0 .35rem; }
      .date { color:#6b7280; font-size:.8rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="nav-link">← Urban Acoustics Mumbai</a>
        <h1>Mumbai Guitar Learning Guides</h1>
        <p class="subtitle">Our archive of guitar-learning articles covering lesson choices, practice, beginner questions and Mumbai-specific considerations.</p>
      </header>

      <main>
        {(!posts || posts.length === 0) ? (
          <p>No guides are currently available.</p>
        ) : (
          <div class="guides-list">
            {posts.map((post) => (
              <a href={`/posts/${post.slug}`} class="guide-card">
                <h2 class="guide-title">{post.title}</h2>
                {post.published_at && <div class="date">{new Date(post.published_at).toLocaleDateString('en-IN', { year:'numeric', month:'short', day:'numeric' })}</div>}
              </a>
            ))}
          </div>
        )}
      </main>
    </div>
  </body>
</html>