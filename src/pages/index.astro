---
export const prerender = false;

const SITE_URL = 'https://urban-acoustics-mumbai.vercel.app';
const canonicalURL = SITE_URL + '/';

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Urban Acoustics Mumbai",
  "url": canonicalURL,
  "description": "Editorial notes about learning guitar in Mumbai."
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Urban Acoustics Mumbai",
  "url": canonicalURL,
  "areaServed": { "@type": "City", "name": "Mumbai" }
};
---

<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Acoustics Mumbai | Guitar Learning Editorial</title>
    <meta name="description" content="Urban Acoustics Mumbai is an editorial property covering guitar learning and private lesson formats in Mumbai." />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Urban Acoustics Mumbai | Guitar Learning Editorial" />
    <meta property="og:description" content="Editorial notes about guitar learning and private lesson formats in Mumbai." />
    <meta property="og:url" content={canonicalURL} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <style>
      :root { font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
      body { margin:0; background:#f9fafb; color:#111827; padding:4rem 1rem; }
      .container { max-width:780px; margin:0 auto; }
      h1 { font-size:clamp(2.4rem,6vw,4rem); line-height:1.04; letter-spacing:-.035em; margin:.4rem 0 1rem; }
      h2 { margin-top:2.2rem; }
      p { color:#4b5563; line-height:1.75; }
      .label { color:#6b7280; text-transform:uppercase; font-size:.75rem; letter-spacing:.1em; font-weight:700; }
      .notice,.disclosure { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:1.1rem 1.2rem; margin:1.5rem 0; }
      .cta { display:inline-block; margin-top:1rem; padding:.85rem 1.2rem; border-radius:999px; background:#1d4ed8; color:#fff; text-decoration:none; font-weight:650; }
      footer { margin-top:3rem; border-top:1px solid #e5e7eb; padding-top:1.5rem; color:#6b7280; font-size:.85rem; }
    </style>
  </head>
  <body>
    <main class="container">
      <div class="label">Mumbai guitar-learning editorial</div>
      <h1>Urban Acoustics Mumbai</h1>
      <p>Urban Acoustics Mumbai is being rebuilt around fewer, manually reviewed articles rather than high-volume locality publishing.</p>

      <div class="notice">
        <strong>Archive review in progress.</strong>
        <p>Older automatically generated location guides have been removed from search discovery while their local claims, prices and third-party references are reviewed. New articles will only be published after factual and editorial checks.</p>
      </div>

      <div class="disclosure">
        <strong>Editorial disclosure:</strong>
        <p>Urban Acoustics Mumbai and Guitar Classes in Mumbai have the same owner. References to that service are disclosed and should not be read as independent third-party endorsements.</p>
      </div>

      <h2>Looking for the actual lesson service?</h2>
      <p>For current lesson formats, fees, instructor information and booking details, use the official Guitar Classes in Mumbai website.</p>
      <a class="cta" href="https://guitar-classes-in-mumbai.vercel.app/" rel="sponsored noopener">Visit Guitar Classes in Mumbai</a>

      <footer>© 2026 Urban Acoustics Mumbai. Editorial archive under review.</footer>
    </main>
  </body>
</html>