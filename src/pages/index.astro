---
import { supabase } from '../lib/supabase';

// Fetch published posts safely without referencing missing columns
const { data: posts, error } = await supabase
  .from('posts')
  .select('title, slug');

if (error) {
  console.error('Error fetching posts for index:', error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Acoustics Mumbai | Guitar Classes & Coaching Directory</title>
    <meta name="description" content="Discover top localized guitar classes, music tutors, and coaching academies across Mumbai." />
  </head>
  <body style="max-width: 800px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif; background-color: #f9fafb; color: #111827;">
    
    <header style="margin-bottom: 2rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.5rem;">Urban Acoustics Mumbai</h1>
      <p style="color: #4b5563;">Your localized directory for guitar coaching and academies across Mumbai.</p>
      <nav style="margin-top: 1rem;">
        <a href="/guides" style="color: #2563eb; font-weight: 600; text-decoration: none;">Browse All Location Guides →</a>
      </nav>
    </header>

    <main>
      <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">Latest Guides</h2>
      {(!posts || posts.length === 0) ? (
        <p style="color: #6b7280;">No guides published yet.</p>
      ) : (
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
          {posts.map((post) => (
            <li style="padding: 1.25rem; background: #ffffff; border-radius: 8px; border: 1px solid #e5e7eb;">
              <a href={`/posts/${post.slug}`} style="font-size: 1.125rem; font-weight: 600; color: #2563eb; text-decoration: none;">
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </main>

  </body>
</html>