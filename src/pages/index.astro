---
import { supabase } from '../lib/supabase';

// Fetch all posts from Supabase
const { data: posts, error } = await supabase
  .from('posts')
  .select('title, slug');

if (error) {
  console.error('Error fetching posts:', error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Guitar Classes & Tutors in Mumbai | Urban Acoustics</title>
    <meta name="description" content="Find top-rated guitar tutors and music academies across Mumbai." />
    <meta name="google-site-verification" content="YiFyJRCt1GnRHowxXNoNgzXFm8po6mnhCAFvVwfO8pI" />

  </head>
  <body style="max-width: 800px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif; background-color: #f9fafb; color: #111827;">
    <header style="margin-bottom: 2.5rem; text-align: center; border-bottom: 1px solid #e5e7eb; padding-bottom: 1.5rem;">
      <h1 style="font-size: 2.25rem; font-weight: 800; margin: 0;">Urban Acoustics Mumbai</h1>
      <p style="color: #4b5563; margin-top: 0.5rem;">Your automated directory for guitar coaching in Mumbai.</p>
    </header>

    <main>
      <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem;">Latest Guides</h2>
      
      {(!posts || posts.length === 0) ? (
        <p>No posts published yet.</p>
      ) : (
        <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
          {posts.map((post) => (
            <li style="padding: 1.25rem; background: #ffffff; border-radius: 8px; border: 1px solid #e5e7eb;">
              <a href={`/posts/${post.slug}`} style="font-size: 1.25rem; font-weight: 600; color: #2563eb; text-decoration: none;">
                {post.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>