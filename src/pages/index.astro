---
export const prerender = false;

import { supabase } from '../lib/supabase';

const SITE_URL = 'https://urban-acoustics-mumbai.vercel.app';
const canonicalURL = SITE_URL + '/';

const { data: posts, error } = await supabase
  .from('posts')
  .select('title, slug, published_at, summary')
  .order('published_at', { ascending: false });

if (error) console.error('Error fetching posts:', error);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Urban Acoustics Mumbai",
  "url": canonicalURL,
  "description": "Independent editorial guides about learning guitar in Mumbai, including lesson formats, practice advice and local considerations."
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Urban Acoustics Mumbai",
  "url": canonicalURL,
  "areaServed": { "@type": "City", "name": "Mumbai" }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Acoustics Mumbai | Guitar Learning Guides & Local Advice</title>
    <meta name="description" content="Practical Mumbai guitar-learning guides covering lesson formats, practice, fees, beginner questions and local considerations." />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Urban Acoustics Mumbai | Guitar Learning Guides & Local Advice" />
    <meta property="og:description" content="Practical Mumbai guitar-learning guides covering lesson formats, practice, fees and local considerations." />
    <meta property="og:url" content={canonicalURL} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <style>
      :root { font-family: system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; color-scheme: light; }
      body { margin:0; background:#f9fafb; color:#111827; min-height:100vh; padding:3rem 1rem; }
      .container { max-width:860px; margin:0 auto; }
      h1 { font-size:2.4rem; line-height:1.1; margin:.5rem 0 .5rem; letter-spacing:-.03em; }
      .subtitle { color:#4b5563; font-size:1rem; line-height:1.65; margin-bottom:1.2rem; }
      .disclosure { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.1rem; color:#4b5563; font-size:.9rem; line-height:1.55; margin:1.5rem 0 2rem; }
      .guides-list { display:flex; flex-direction:column; gap:.8rem; }
      .guide-card { display:block; padding:1.2rem 1.4rem; background:#fff; border-radius:10px; border:1px solid #e5e7eb; text-decoration:none; }
      .guide-card:hover { border-color:#2563eb; box-shadow:0 4px 14px rgba(0,0,0,.06); }
      .guide-title { font-size:1.08rem; color:#1d4ed8; margin:0 0 .35rem; }
      .date { color:#6b7280; font-size:.8rem; }
      .footer { margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid #e5e7eb; color:#6b7280; font-size:.85rem; line-height:1.6; }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <p class="date">Mumbai guitar-learning publication</p>
        <h1>Urban Acoustics Mumbai</h1>
        <p class="subtitle">Practical guides for people learning guitar in Mumbai: lesson formats, realistic practice advice, beginner questions, fees and neighborhood-specific considerations.</p>
        <div class="disclosure">
          <strong>Editorial disclosure:</strong> Urban Acoustics Mumbai is an editorial property operated by the same owner as Guitar Classes in Mumbai. Some articles link to that service where relevant. Those links are clearly intended as service references, not independent endorsements.
        </div>
      </header>

      <main>
        <h2>Latest guides</h2>
        {(!posts || posts.length === 0) ? (
          <p>No guides are currently available.</p>
        ) : (
          <div class="guides-list">
            {posts.map((post) => (
              <a href={`/posts/${post.slug}`} class="guide-card">
                <h3 class="guide-title">{post.title}</h3>
                {post.published_at && <div class="date">{new Date(post.published_at).toLocaleDateString('en-IN', { year:'numeric', month:'short', day:'numeric' })}</div>}
              </a>
            ))}
          </div>
        )}
      </main>

      <footer class="footer">
        Content is written for general educational purposes. Local prices, availability and businesses can change; verify time-sensitive information directly with the relevant provider.
      </footer>
    </div>
  </body>
</html>