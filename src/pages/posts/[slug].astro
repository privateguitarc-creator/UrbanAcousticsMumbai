---
export const prerender = false;

import { supabase } from '../../lib/supabase';
import { marked } from 'marked';

const SITE_URL = 'https://urban-acoustics-mumbai.vercel.app';
const { slug } = Astro.params;

const { data: post, error } = await supabase
  .from('posts')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !post) return Astro.redirect('/404');

const { data: rawRelated } = await supabase
  .from('posts')
  .select('title, slug, published_at')
  .neq('slug', slug)
  .order('published_at', { ascending: false })
  .limit(6);

const relatedPosts = (rawRelated || []).slice(0, 3);

const DEFAULT_HERO_IMAGE = 'https://images.unsplash.com/photo-1510915361894-db8b60106cb1?q=80&w=1200&auto=format&fit=crop';
const displayImage = post.hero_image || post.featured_image || DEFAULT_HERO_IMAGE;

const cleanContent = post.content ? post.content.replace(/!\[.*?\]\(.*?\)/g, '').trim() : '';
const htmlContent = cleanContent ? marked.parse(cleanContent) : '';

const canonicalURL = `${SITE_URL}/posts/${post.slug}`;
const description = post.summary || post.meta_description || post.title;
const datePublished = post.published_at || undefined;
const dateModified = post.updated_at || post.published_at || undefined;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": description,
  "mainEntityOfPage": canonicalURL,
  "url": canonicalURL,
  "image": [displayImage],
  ...(datePublished ? { "datePublished": datePublished } : {}),
  ...(dateModified ? { "dateModified": dateModified } : {}),
  "author": {
    "@type": "Organization",
    "name": "Urban Acoustics Mumbai",
    "url": SITE_URL
  },
  "publisher": {
    "@type": "Organization",
    "name": "Urban Acoustics Mumbai",
    "url": SITE_URL
  }
};

let faqSchema = null;
if (post.faqs && Array.isArray(post.faqs) && post.faqs.length > 0) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.faqs.map((faq: { question: string; answer: string }) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
    }))
  };
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | Urban Acoustics Mumbai</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={displayImage} />
    {datePublished && <meta property="article:published_time" content={datePublished} />}

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>

  <body>
    <div class="page">
      <header class="site-header">
        <a href="/" class="brand">Urban Acoustics Mumbai</a>
        <a href="/guides" class="archive">All guides</a>
      </header>

      <main>
        <article>
          <p class="eyebrow">Mumbai guitar learning guide</p>
          <h1>{post.title}</h1>

          {datePublished && (
            <p class="meta">Published {new Date(datePublished).toLocaleDateString('en-IN', { year:'numeric', month:'long', day:'numeric' })}</p>
          )}

          <img src={displayImage} alt={post.title} class="hero" />

          <div class="disclosure">
            <strong>Editorial disclosure:</strong> Urban Acoustics Mumbai and Guitar Classes in Mumbai have the same owner. Where this article links to that service, the relationship is disclosed rather than presented as an independent endorsement.
          </div>

          <div class="content" set:html={htmlContent} />
        </article>

        <aside class="service-cta">
          <h2>Looking for private guitar lessons at home in Mumbai?</h2>
          <p>See lesson format, fees, instructor information and booking details on the official Guitar Classes in Mumbai website.</p>
          <a href="https://guitar-classes-in-mumbai.vercel.app/" rel="sponsored noopener">View Guitar Classes in Mumbai →</a>
        </aside>

        {relatedPosts.length > 0 && (
          <section class="related">
            <h2>More Mumbai guitar guides</h2>
            <ul>
              {relatedPosts.map((related) => (
                <li><a href={`/posts/${related.slug}`}>{related.title}</a></li>
              ))}
            </ul>
          </section>
        )}
      </main>

      <footer>
        Information can change over time. Verify current prices, availability and third-party business details directly before acting on them.
      </footer>
    </div>

    <style is:global>
      :root { font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; color:#111827; background:#f9fafb; }
      body { margin:0; }
      .page { max-width:820px; margin:0 auto; padding:2rem 1rem 3rem; }
      .site-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:2.5rem; }
      .site-header a { color:#1d4ed8; text-decoration:none; font-weight:650; }
      .brand { color:#111827!important; }
      .archive { font-size:.9rem; }
      .eyebrow { color:#6b7280; font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; }
      h1 { font-size:clamp(2rem,5vw,3rem); line-height:1.08; letter-spacing:-.03em; margin:.5rem 0; }
      .meta { color:#6b7280; font-size:.85rem; margin-bottom:1.5rem; }
      .hero { width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:12px; margin:1rem 0 1.5rem; }
      .disclosure { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:1rem; color:#4b5563; font-size:.88rem; line-height:1.55; margin-bottom:2rem; }
      .content h2,.content h3 { margin-top:2rem; margin-bottom:.75rem; color:#111827; }
      .content h2 { font-size:1.55rem; }
      .content h3 { font-size:1.25rem; }
      .content p,.content li { line-height:1.78; color:#374151; font-size:1.04rem; }
      .content ul,.content ol { padding-left:1.4rem; }
      .content a { color:#1d4ed8; text-decoration:underline; }
      .content table { width:100%; border-collapse:collapse; margin:1.5rem 0; }
      .content th,.content td { border:1px solid #e5e7eb; padding:.75rem; text-align:left; }
      .content th { background:#f3f4f6; }
      .service-cta { margin:3rem 0; padding:1.5rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:12px; }
      .service-cta h2 { margin-top:0; font-size:1.3rem; }
      .service-cta p { color:#475569; line-height:1.6; }
      .service-cta a { color:#1d4ed8; font-weight:700; }
      .related { margin-top:2.5rem; padding-top:2rem; border-top:1px solid #e5e7eb; }
      .related li { margin:.65rem 0; }
      .related a { color:#1d4ed8; }
      footer { margin-top:3rem; padding-top:1.5rem; border-top:1px solid #e5e7eb; color:#6b7280; font-size:.82rem; line-height:1.55; }
    </style>
  </body>
</html>