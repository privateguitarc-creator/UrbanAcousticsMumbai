---
export const prerender = false;

import { supabase } from '../../lib/supabase';
import { marked } from 'marked';

const { slug } = Astro.params;

const { data: post, error } = await supabase
  .from('posts')
  .select('*')
  .eq('slug', slug)
  .single();

if (error || !post) {
  return Astro.redirect('/404');
}

const { data: relatedPosts } = await supabase
  .from('posts')
  .select('title, slug')
  .neq('slug', slug)
  .limit(3);

const DEFAULT_HERO_IMAGE = 'https://images.unsplash.com/photo-1510915361894-db8b60106cb1?q=80&w=1200&auto=format&fit=crop';
const displayImage = post.hero_image || post.featured_image || DEFAULT_HERO_IMAGE;

const cleanContent = post.content ? post.content.replace(/!\[.*?\]\(.*?\)/g, '').trim() : '';
const htmlContent = cleanContent ? marked.parse(cleanContent) : '';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.summary || post.meta_description || post.title,
  "image": [displayImage],
  "author": {
    "@type": "Organization",
    "name": "Urban Acoustics Mumbai"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Urban Acoustics Mumbai",
    "url": "https://urban-acoustics-mumbai.vercel.app"
  }
};

let faqSchema = null;
if (post.faqs && Array.isArray(post.faqs) && post.faqs.length > 0) {
  faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.faqs.map((faq: { question: string; answer: string }) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  };
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | Urban Acoustics Mumbai</title>
    <meta name="description" content={post.summary || post.meta_description || post.title} />

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body style="max-width: 800px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif; background-color: #f9fafb; color: #111827;">
    
    <header style="margin-bottom: 2rem;">
      <a href="/guides" style="color: #2563eb; font-weight: 600; text-decoration: none;">← All Location Guides</a>
    </header>

    <main>
      <article>
        <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 1.5rem; line-height: 1.2;">{post.title}</h1>
        
        <img 
          src={displayImage} 
          alt={post.title} 
          style="width: 100%; height: 380px; object-fit: cover; border-radius: 8px; margin-bottom: 2rem;" 
        />

        <div class="content" set:html={htmlContent} />
      </article>

      <div style="margin: 3rem 0; padding: 2.5rem 2rem; background-color: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; text-align: center;">
        <h3 style="font-size: 1.35rem; font-weight: 700; color: #1e3a8a; margin-top: 0; margin-bottom: 0.5rem;">
          Want Personalized Guitar Coaching at Home?
        </h3>
        <p style="color: #3b82f6; margin-top: 0; margin-bottom: 1.5rem; font-size: 0.95rem;">
          Learn from expert tutors across Mumbai with tailored 1-on-1 doorstep sessions.
        </p>
        <a 
          href="https://guitar-classes-in-mumbai.vercel.app/" 
          target="_blank" 
          rel="noopener noreferrer" 
          style="display: inline-block; background-color: #2563eb; color: #ffffff; font-weight: 600; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-size: 0.95rem;"
        >
          Book Your Doorstep Masterclass →
        </a>
      </div>

      {relatedPosts && relatedPosts.length > 0 && (
        <section style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #e5e7eb;">
          <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1rem;">
            Related Local Guides in Mumbai
          </h2>
          <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.75rem;">
            {relatedPosts.map((related) => (
              <li>
                <a 
                  href={`/posts/${related.slug}`} 
                  style="color: #2563eb; text-decoration: underline; font-weight: 500;"
                >
                  {related.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>

    <style is:global>
      .content h1, .content h2, .content h3 {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        font-weight: 700;
        color: #111827;
      }
      .content h2 { font-size: 1.5rem; }
      .content h3 { font-size: 1.25rem; }
      .content p {
        line-height: 1.75;
        margin-bottom: 1.25rem;
        color: #374151;
        font-size: 1.05rem;
      }
      .content img {
        width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 8px;
        margin: 1.5rem 0;
      }
      .content ul, .content ol {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
        color: #374151;
      }
      .content li {
        margin-bottom: 0.5rem;
        line-height: 1.6;
      }
      .content a {
        color: #2563eb;
        text-decoration: underline;
      }
      .content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
      }
      .content th, .content td {
        border: 1px solid #e5e7eb;
        padding: 0.75rem;
        text-align: left;
      }
      .content th {
        background-color: #f3f4f6;
        font-weight: 600;
      }
    </style>

  </body>
</html>