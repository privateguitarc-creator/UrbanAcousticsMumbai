---
export const prerender = false;

Astro.response.status = 410;
Astro.response.statusText = 'Gone';
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600');
---

<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Article Retired | Urban Acoustics Mumbai</title>
    <meta name="robots" content="noindex,nofollow" />
    <style>
      :root { font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
      body { margin:0; background:#f9fafb; color:#111827; min-height:100vh; display:grid; place-items:center; padding:2rem; }
      main { max-width:680px; background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:2rem; }
      h1 { margin-top:0; font-size:2rem; }
      p { color:#4b5563; line-height:1.7; }
      a { color:#1d4ed8; font-weight:700; }
    </style>
  </head>
  <body>
    <main>
      <h1>This legacy article has been retired</h1>
      <p>Urban Acoustics Mumbai has removed its earlier automatically generated locality archive. New articles are published only after manual review.</p>
      <p><a href="/">Go to Urban Acoustics Mumbai</a></p>
    </main>
  </body>
</html>
